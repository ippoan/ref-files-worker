# @ippoan scope (@ippoan/mcp-cf-workers 等) は GitHub Packages 公開。
# CI / deploy では frontend-ci.yml が npm_scope:'@ippoan' で setup-node を構成し
# NODE_AUTH_TOKEN=GITHUB_TOKEN を注入する。ローカルは PAT (read:packages) を
# NODE_AUTH_TOKEN に入れるか、lib を file: link する。
@ippoan:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}

# @ippoan/mcp-cf-workers は durable (DO+WS) path 用に `agents` を optional peer
# として宣言している。`agents` は vite >=6 を peer 要求するが、本 repo の
# vitest 2.x は vite 5 系。ref-files は durable path (`createDurableMcp`) を
# 使わず stateless `createWorkerMcp` のみなので、この optional peer 衝突は
# 無視してよい。npm の旧 peer アルゴリズムで素通しする。
legacy-peer-deps=true
